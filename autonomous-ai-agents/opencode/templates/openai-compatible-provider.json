{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "<provider-id>": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "<display name>",
      "options": {
        "baseURL": "http://<host>:<port>/v1",
        "apiKey": "local"
      },
      "models": {
        "<exact-model-id-from-/v1/models>": {
          "name": "<human label>",
          "tool_call": false
        }
      }
    }
  }
}
